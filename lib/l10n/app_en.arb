  "helpTitle": "Help",
  "helpIntro": "Quick guidance for provisioning a server.",
  "helpAddServerTitle": "Adding a server",
  "helpAddServerBody": "Enter the SSH host, port and credentials. The password is used only for this session and never stored.",
  "helpInstallTitle": "Installation",
  "helpInstallBody": "The installer runs on the server and survives connection loss. Reopen the app to resume an interrupted run.",
  "helpSecurityTitle": "Security",
  "helpSecurityBody": "Host keys are pinned on first use. Disabling root SSH access is protected by an anti-lockout check.",
  "glossaryAllowedIpsTitle": "Allowed IPs",
  "@glossaryAllowedIpsTitle": { "description": "Glossary title — Allowed IPs." },
  "glossaryAllowedIpsBody": "The list of addresses that a peer is allowed to send traffic to through the VPN tunnel. For a typical client, this includes the VPN server's internal network and, often, the entire Internet (0.0.0.0/0). For a peer entry on the server side, it normally contains only the peer's own VPN address.",
  "@glossaryAllowedIpsBody": { "description": "Glossary body — Allowed IPs." },
  "glossaryDnsTitle": "DNS",
  "@glossaryDnsTitle": { "description": "Glossary title — DNS." },
  "glossaryDnsBody": "The system that turns names like example.com into IP addresses your device can connect to. WireGuard lets each peer use a custom DNS server, which is useful when you want all DNS queries to go through the VPN instead of your local network.",
  "@glossaryDnsBody": { "description": "Glossary body — DNS." },
  "glossaryFingerprintTitle": "Fingerprint",
  "@glossaryFingerprintTitle": { "description": "Glossary title — fingerprint." },
  "glossaryFingerprintBody": "A short summary of a server's identity key. The first time you connect, the app shows the fingerprint and locks it in. On every later connection, the app refuses to talk to the server if its fingerprint has changed — a change can indicate someone is impersonating it.",
  "@glossaryFingerprintBody": { "description": "Glossary body — fingerprint." },
  "glossaryFirewallTitle": "Firewall",
  "@glossaryFirewallTitle": { "description": "Glossary title — firewall." },
  "glossaryFirewallBody": "A set of rules that controls which network traffic is allowed in and out of a system. On a VPN server, the firewall is configured to allow incoming connections on the WireGuard port and to forward traffic between the VPN tunnel and the public Internet. Without the right firewall rules, clients cannot reach the server or browse the web through the VPN.",
  "@glossaryFirewallBody": { "description": "Glossary body — firewall." },
  "glossaryHandshakeTitle": "Handshake",
  "@glossaryHandshakeTitle": { "description": "Glossary title — handshake." },
  "glossaryHandshakeBody": "The brief exchange of cryptographic data that two WireGuard peers perform to agree on a shared session key. A successful handshake means both sides have verified each other's identity and are ready to encrypt traffic. The most recent handshake timestamp is a reliable indicator of whether a peer is currently reachable.",
  "@glossaryHandshakeBody": { "description": "Glossary body — handshake." },
  "glossaryMtuTitle": "MTU",
  "@glossaryMtuTitle": { "description": "Glossary title — MTU." },
  "glossaryMtuBody": "Maximum Transmission Unit — the largest packet size, in bytes, that a network link will carry in a single chunk. WireGuard adds a small amount of overhead to each packet, so the MTU of the VPN tunnel is usually set a little lower than your regular network's MTU. Setting it too high causes packets to be fragmented and slows down the connection; setting it too low wastes bandwidth.",
  "@glossaryMtuBody": { "description": "Glossary body — MTU." },
  "glossaryPeerTitle": "Peer",
  "@glossaryPeerTitle": { "description": "Glossary title — peer." },
  "glossaryPeerBody": "Any device that participates in a WireGuard VPN — both the server and each client are called peers. Every peer has a unique public key that identifies it, and a list of Allowed IPs that tells other peers what traffic to send its way. Adding a peer to the server creates a configuration entry for that device and generates a client profile it can import.",
  "@glossaryPeerBody": { "description": "Glossary body — peer." },
  "glossaryPublicPrivateKeyTitle": "Public and private keys",
  "@glossaryPublicPrivateKeyTitle": { "description": "Glossary title — public and private keys." },
  "glossaryPublicPrivateKeyBody": "WireGuard uses a pair of mathematically linked keys for each peer. The private key is a secret kept only on the peer's own device and is never shared with anyone. The public key is derived from the private key and can be shared freely — it tells other peers how to encrypt data so that only the holder of the matching private key can read it. This app generates and stores the key pair for you automatically.",
  "@glossaryPublicPrivateKeyBody": { "description": "Glossary body — public and private keys." },
  "glossaryHardeningTitle": "SSH hardening",
  "glossaryHardeningBody": "Optional steps that make a server harder to break into: blocking repeated failed logins (fail2ban) and turning off password sign-in in favour of keys. Because turning off passwords changes how you log in, getting it wrong can lock you out. This app applies it only after it has created and tested your new key-based login, backed up the existing SSH configuration, and run a dry-run check, and it rolls everything back automatically if a step fails.",
  "glossarySshTitle": "SSH",
  "@glossarySshTitle": { "description": "Glossary title — SSH." },
  "glossarySshBody": "Secure Shell — an encrypted protocol used to log in to and run commands on a remote server over any network. This app uses SSH to reach your server, run the WireGuard installer, and retrieve peer status. Your SSH credentials are used only for the duration of each operation and are never stored on the device.",
  "@glossarySshBody": { "description": "Glossary body — SSH." },
  "glossarySubnetTitle": "Subnet",
  "@glossarySubnetTitle": { "description": "Glossary title — subnet." },
  "glossarySubnetBody": "A range of IP addresses that belong to the same logical network, written in CIDR notation (for example, 10.0.0.0/24). Inside a WireGuard VPN, the subnet defines the pool of addresses available to the server and its peers. A /24 subnet provides up to 254 usable addresses, which is enough for most personal or small-team deployments.",
  "@glossarySubnetBody": { "description": "Glossary body — subnet." },
  "glossarySudoTitle": "Sudo",
  "@glossarySudoTitle": { "description": "Glossary title — sudo." },
  "glossarySudoBody": "A command on Linux systems that lets a regular user run specific commands with administrator (root) privileges. The WireGuard installer needs sudo to install packages, configure network interfaces and modify system files. The account you use to connect must have sudo access; otherwise the installation cannot proceed.",
  "@glossarySudoBody": { "description": "Glossary body — sudo." },
  "glossaryUdpPortTitle": "UDP port",
  "@glossaryUdpPortTitle": { "description": "Glossary title — UDP port." },
  "glossaryUdpPortBody": "The numbered \"door\" on the server through which WireGuard listens for incoming connections. WireGuard uses the UDP protocol rather than TCP, so this port must be open in the server's firewall for UDP traffic. The default port is 51820, but you can change it to any unused port number if needed.",
  "@glossaryUdpPortBody": { "description": "Glossary body — UDP port." },
  "glossaryVpnTitle": "VPN",
  "@glossaryVpnTitle": { "description": "Glossary title — VPN." },
  "glossaryVpnBody": "Virtual Private Network — a technology that creates an encrypted tunnel between your device and a server, making it appear as though your device is on the same local network as that server. All traffic sent through the tunnel is hidden from anyone on the path between you and the server. WireGuard is one of the simplest and fastest ways to set up a VPN.",
  "@glossaryVpnBody": { "description": "Glossary body — VPN." },
  "glossaryWireguardTitle": "WireGuard",
  "@glossaryWireguardTitle": { "description": "Glossary title — WireGuard." },
  "glossaryWireguardBody": "A modern, open-source VPN protocol built directly into the Linux kernel. Compared to older VPN solutions, WireGuard has a much smaller codebase, is easier to audit for security, and typically offers faster connection speeds and lower battery use on mobile devices. This app sets up WireGuard on your server automatically so you do not need to configure it by hand.",
  "@glossaryWireguardBody": { "description": "Glossary body — WireGuard." },
