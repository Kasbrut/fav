  "reprobeSuccess": "System information updated.",
  "errConnHostUnreachable": "Cannot reach the server. Check the IP address and your connection.",
  "@errConnHostUnreachable": {
    "description": "User message for error ERR-CONN-01."
  },
  "errConnHostUnreachableCause": "Your device can reach the Internet, but it cannot reach the server's address. The address may be wrong, the server may be powered off, or a firewall between you and the server may be blocking traffic.",
  "@errConnHostUnreachableCause": {
    "description": "Cause text for ERR-CONN-01 on the troubleshooting card."
  },
  "errConnHostUnreachableFix": "Double-check the IP address or hostname of the server. Make sure the server is running, and if it is hosted on a cloud provider, verify that the provider's firewall allows incoming connections from your IP.",
  "@errConnHostUnreachableFix": {
    "description": "Fix text for ERR-CONN-01 on the troubleshooting card."
  },
  "errConnSshPortClosed": "The SSH port is not responding.",
  "@errConnSshPortClosed": {
    "description": "User message for error ERR-CONN-02."
  },
  "errConnSshPortClosedCause": "The server is reachable, but the SSH port does not respond. SSH may be turned off on the server, or a firewall is blocking that specific port.",
  "@errConnSshPortClosedCause": {
    "description": "Cause text for ERR-CONN-02 on the troubleshooting card."
  },
  "errConnSshPortClosedFix": "Make sure the SSH service is running on the server. Most cloud providers leave it on by default. Then check your firewall rules and confirm that the SSH port is allowed for inbound connections.",
  "@errConnSshPortClosedFix": {
    "description": "Fix text for ERR-CONN-02 on the troubleshooting card."
  },
  "errConnAddressNotFound": "No server found at that address.",
  "@errConnAddressNotFound": {
    "description": "User message for error ERR-CONN-03."
  },
  "errConnAddressNotFoundCause": "The address you entered could not be looked up, so it points to no server. The IP address or domain name is most likely mistyped, or the domain no longer resolves.",
  "@errConnAddressNotFoundCause": {
    "description": "Cause text for ERR-CONN-03 on the troubleshooting card."
  },
  "errConnAddressNotFoundFix": "Check the address for typos. Use the server's IP address (for example 192.168.1.10) or its full domain name (for example vpn.example.com). If you use a dynamic-DNS name, confirm it still points to the server.",
  "@errConnAddressNotFoundFix": {
    "description": "Fix text for ERR-CONN-03 on the troubleshooting card."
  },
  "errAuthInvalidCredentials": "Incorrect username or password.",
  "@errAuthInvalidCredentials": {
    "description": "User message for error ERR-AUTH-01."
  },
  "errAuthInvalidCredentialsCause": "The username or password you entered was refused by the server. This can also happen if the account is temporarily locked after too many failed attempts.",
  "@errAuthInvalidCredentialsCause": {
    "description": "Cause text for ERR-AUTH-01 on the troubleshooting card."
  },
  "errAuthInvalidCredentialsFix": "Re-enter the credentials carefully — passwords are case-sensitive. If you keep getting this error, wait a few minutes (some servers lock an account after repeated failures) and try again.",
  "@errAuthInvalidCredentialsFix": {
    "description": "Fix text for ERR-AUTH-01 on the troubleshooting card."
  },
  "errAuthNoSudo": "The user does not have the required sudo permissions.",
  "@errAuthNoSudo": {
    "description": "User message for error ERR-AUTH-02."
  },
  "errAuthNoSudoCause": "The account you used to log in exists on the server but does not have permission to run commands as administrator (sudo). The installer needs those elevated permissions to configure the system.",
  "@errAuthNoSudoCause": {
    "description": "Cause text for ERR-AUTH-02 on the troubleshooting card."
  },
  "errAuthNoSudoFix": "Log in to the server with an account that has sudo access, or ask the server administrator to grant sudo permissions to this account. Then try connecting again.",
  "@errAuthNoSudoFix": {
    "description": "Fix text for ERR-AUTH-02 on the troubleshooting card."
  },
  "errHostKeyMismatch": "The server identity has changed. Possible MITM attack.",
  "@errHostKeyMismatch": {
    "description": "User message for error ERR-HOST-01."
  },
  "errHostKeyMismatchCause": "The cryptographic fingerprint stored for this server no longer matches what the server is presenting. This can happen after a server rebuild or OS reinstall, but it is also a sign of a potential man-in-the-middle attack.",
  "@errHostKeyMismatchCause": {
    "description": "Cause text for ERR-HOST-01 on the troubleshooting card."
  },
  "errHostKeyMismatchFix": "If the change was unexpected, do not reconnect. If you changed the server intentionally, verify the new fingerprint through your provider console. In the server details, refresh the system information if needed, then use Replace fingerprint and authenticate to update the pinned identity.",
  "@errHostKeyMismatchFix": {
    "description": "Fix text for ERR-HOST-01 on the troubleshooting card."
  },
  "errSysUnsupportedDistro": "Unsupported OS. Debian or Ubuntu is required.",
  "@errSysUnsupportedDistro": {
    "description": "User message for error ERR-SYS-01."
  },
  "errSysUnsupportedDistroCause": "The installer only supports Debian and Ubuntu. The server is running a different Linux distribution that is not compatible with the provisioning scripts.",
  "@errSysUnsupportedDistroCause": {
    "description": "Cause text for ERR-SYS-01 on the troubleshooting card."
  },
  "errSysUnsupportedDistroFix": "Reinstall the server with a supported operating system — a recent version of Debian or Ubuntu is recommended. Then try provisioning again.",
  "@errSysUnsupportedDistroFix": {
    "description": "Fix text for ERR-SYS-01 on the troubleshooting card."
  },
  "errSysKernelTooOld": "The kernel is not compatible with WireGuard.",
  "@errSysKernelTooOld": {
    "description": "User message for error ERR-SYS-02."
  },
  "errSysKernelTooOldCause": "WireGuard requires a Linux kernel version that includes the WireGuard module. The server's current kernel is older than that minimum and cannot run WireGuard natively.",
  "@errSysKernelTooOldCause": {
    "description": "Cause text for ERR-SYS-02 on the troubleshooting card."
  },
  "errSysKernelTooOldFix": "Update the server to a newer version of Debian or Ubuntu that ships with a compatible kernel. After the upgrade, try provisioning again.",
  "@errSysKernelTooOldFix": {
    "description": "Fix text for ERR-SYS-02 on the troubleshooting card."
  },
  "errRunLost": "The run was lost (reboot or cleanup). Start a new installation.",
  "@errRunLost": {
    "description": "User message for error ERR-RUN-01."
  },
  "errRunLostCause": "The installation was running on the server in the background, but the files tracking its progress are no longer there. This usually means the server was rebooted or the temporary files were cleaned up before the run finished.",
  "@errRunLostCause": {
    "description": "Cause text for ERR-RUN-01 on the troubleshooting card."
  },
  "errRunLostFix": "The installer can be run multiple times safely — steps that already completed will be skipped automatically. Reopen the server detail and start a new installation; it will pick up from a safe point.",
  "@errRunLostFix": {
    "description": "Fix text for ERR-RUN-01 on the troubleshooting card."
  },
  "errRunStepFailed": "Step {stepName} failed. See details.",
  "@errRunStepFailed": {
    "description": "User message for error ERR-RUN-02.",
    "placeholders": {
      "stepName": {
        "type": "String"
      }
    }
  },
  "errRunStepFailedCause": "One of the installation steps encountered an error on the server. This can be caused by a package manager issue, a transient network hiccup while downloading packages, or a configuration conflict left from a previous partial install.",
  "@errRunStepFailedCause": {
    "description": "Cause text for ERR-RUN-02 on the troubleshooting card."
  },
  "errRunStepFailedFix": "Review the technical details below for the specific step and error message. If the problem looks like a temporary network issue, starting the installation again is safe. If the error persists, look at the installer log on the server for more context.",
  "@errRunStepFailedFix": {
    "description": "Fix text for ERR-RUN-02 on the troubleshooting card."
  },
  "errLockoutAborted": "Root SSH disabling was cancelled to avoid a lockout. The server is intact.",
  "@errLockoutAborted": {
    "description": "User message for error ERR-LCK-01."
  },
  "errLockoutAbortedCause": "The app tried to disable direct root SSH access as a security step, but the safety checks did not pass — the new admin account could not be verified, or the SSH configuration test failed. To protect you from losing access to the server, the change was cancelled.",
  "@errLockoutAbortedCause": {
    "description": "Cause text for ERR-LCK-01 on the troubleshooting card."
  },
  "errLockoutAbortedFix": "Check that the admin account created during hardening can log in successfully before retrying. The server remains accessible with its current credentials — no access has been lost.",
  "@errLockoutAbortedFix": {
    "description": "Fix text for ERR-LCK-01 on the troubleshooting card."
  },
  "errPasswordTooWeak": "The new password does not meet the minimum requirements.",
  "@errPasswordTooWeak": {
    "description": "User message for error ERR-PWD-01."
  },
  "errPasswordTooWeakCause": "The password you entered is too simple and could be guessed easily. Strong passwords protect the server from unauthorised access.",
  "@errPasswordTooWeakCause": {
    "description": "Cause text for ERR-PWD-01 on the troubleshooting card."
  },
  "errPasswordTooWeakFix": "Choose a longer password that mixes letters, numbers and symbols, and avoid common words or predictable patterns. A passphrase made of several random words also works well.",
  "@errPasswordTooWeakFix": {
    "description": "Fix text for ERR-PWD-01 on the troubleshooting card."
  },
  "errNetNoInternet": "The server has no Internet access.",
  "@errNetNoInternet": {
    "description": "User message for error ERR-NET-01."
  },
  "errNetNoInternetCause": "The server can be reached over SSH, but it cannot connect to the Internet. The installer needs to download WireGuard packages during setup, so this blocks the installation.",
  "@errNetNoInternetCause": {
    "description": "Cause text for ERR-NET-01 on the troubleshooting card."
  },
  "errNetNoInternetFix": "Check the server's network configuration and make sure outbound Internet access is allowed. If the server is behind a firewall, verify that outbound traffic on standard ports is permitted. Once connectivity is restored, try the installation again.",
  "@errNetNoInternetFix": {
    "description": "Fix text for ERR-NET-01 on the troubleshooting card."
  },
  "errScriptInvalid": "The custom script has syntax errors.",
  "@errScriptInvalid": {
    "description": "User message for error ERR-SCRIPT-01."
  },
  "errScriptInvalidCause": "The custom script you provided contains syntax errors. The app checks scripts before sending them to the server, and this one did not pass the check.",
  "@errScriptInvalidCause": {
    "description": "Cause text for ERR-SCRIPT-01 on the troubleshooting card."
  },
  "errScriptInvalidFix": "Open the script editor and look for the lines highlighted as problematic. Fix the syntax errors and save the script before trying again.",
  "@errScriptInvalidFix": {
    "description": "Fix text for ERR-SCRIPT-01 on the troubleshooting card."
  },
  "errPollingTimeout": "No response from the server for too long.",
  "@errPollingTimeout": {
    "description": "User message for error ERR-TMO-01."
  },
  "errPollingTimeoutCause": "The app was waiting for a progress update from the server, but none arrived within the allowed time. The installation may still be running — the server could be under heavy load, or the connection may have been lost.",
  "@errPollingTimeoutCause": {
    "description": "Cause text for ERR-TMO-01 on the troubleshooting card."
  },
  "errPollingTimeoutFix": "Reopen the server detail screen. If the installation is still in progress, the app will reconnect and resume tracking it. If the server appears stuck, you can start a new installation — it is safe to run again.",
  "@errPollingTimeoutFix": {
    "description": "Fix text for ERR-TMO-01 on the troubleshooting card."
  },
  "errSshKeyUnavailable": "The SSH key for this server is missing from the device keychain. Password login has been disabled on the server, so manual recovery on the server is required.",
  "@errSshKeyUnavailable": {
    "description": "User message for error ERR-KEY-01 — stored SSH key missing after hardening."
  },
  "errSshKeyUnavailableCause": "During server hardening, this app generated an SSH key pair and disabled password login on the server. The private key was saved in this device's secure keychain, but it is no longer there — possibly because the app data was cleared or the device was restored from a backup.",
  "@errSshKeyUnavailableCause": {
    "description": "Cause text for ERR-KEY-01 on the troubleshooting card."
  },
  "errSshKeyUnavailableFix": "Because password login is disabled and the app's SSH key is gone, you cannot log in remotely anymore. You will need direct access to the server (such as your cloud provider's web console or a VNC session) to reset the configuration. As a quick rescue, your provider's recovery mode or a snapshot from before the hardening step can also restore access.",
  "@errSshKeyUnavailableFix": {
    "description": "Fix text for ERR-KEY-01 on the troubleshooting card."
  },
  "errSshKeyDeployFailed": "The SSH key could not be saved on the server.",
  "@errSshKeyDeployFailed": {
    "description": "User message for error ERR-KEY-02 — writing to authorized_keys failed."
  },
  "errSshKeyDeployFailedCause": "The app connected to the server but the command that adds the key to the account's authorized_keys file returned an error — for example the home directory is not writable or the disk is full.",
  "@errSshKeyDeployFailedCause": {
    "description": "Cause text for ERR-KEY-02 on the troubleshooting card."
  },
  "errSshKeyDeployFailedFix": "Check that the login account's home directory exists and is writable and that the server has free disk space, then try again.",
  "@errSshKeyDeployFailedFix": {
    "description": "Fix text for ERR-KEY-02 on the troubleshooting card."
  },
  "errMonitorSnapshotInvalid": "The monitor snapshot could not be parsed.",
  "@errMonitorSnapshotInvalid": {
    "description": "User message for error ERR-MON-01 — peers-state.json failed to parse."
  },
  "errMonitorSnapshotInvalidCause": "The monitoring agent on the server wrote a status file that the app could not read. This can happen if the file was partially written during a write cycle or if the agent encountered an unexpected error.",
  "@errMonitorSnapshotInvalidCause": {
    "description": "Cause text for ERR-MON-01 on the troubleshooting card."
  },
  "errMonitorSnapshotInvalidFix": "Wait a moment and refresh — the agent writes a new snapshot every minute and the next one should be valid. If the problem continues, try reinstalling the monitoring agent from the server settings.",
  "@errMonitorSnapshotInvalidFix": {
    "description": "Fix text for ERR-MON-01 on the troubleshooting card."
  },
  "errMonitorAgentNotInstalled": "The monitoring agent is not installed on this server.",
  "@errMonitorAgentNotInstalled": {
    "description": "User message for error ERR-MON-02 — snapshot file missing on the server."
  },
  "errMonitorAgentNotInstalledCause": "Live peer status requires a small monitoring agent running on the server, but it has not been set up yet on this server.",
  "@errMonitorAgentNotInstalledCause": {
    "description": "Cause text for ERR-MON-02 on the troubleshooting card."
  },
  "errMonitorAgentNotInstalledFix": "The VPN still works without monitoring. If monitoring is required, check the installation log and the monitor service on the server, or remove and provision the server again with monitoring enabled.",
  "@errMonitorAgentNotInstalledFix": {
    "description": "Fix text for ERR-MON-02 on the troubleshooting card."
  },
  "errMonitorPullFailed": "The latest monitoring snapshot could not be fetched.",
  "@errMonitorPullFailed": {
    "description": "User message for error ERR-MON-03 — SSH pull failure during polling."
  },
  "errMonitorPullFailedCause": "The app connects to the server over SSH to read the latest monitoring data, but this connection attempt failed. The server may be temporarily unreachable, or the SSH session may have been interrupted.",
  "@errMonitorPullFailedCause": {
    "description": "Cause text for ERR-MON-03 on the troubleshooting card."
  },
  "errMonitorPullFailedFix": "Check your network connection and make sure the server is reachable. The app will retry automatically — if the error persists, check the server connectivity from the detail screen.",
  "@errMonitorPullFailedFix": {
    "description": "Fix text for ERR-MON-03 on the troubleshooting card."
  },
  "errMonitorAgentStale": "The monitoring agent has not reported recently.",
  "@errMonitorAgentStale": {
    "description": "User message for error ERR-MON-04 — agent snapshot older than 90s."
  },
  "errMonitorAgentStaleCause": "The monitoring agent is installed and was working, but its last status report is older than expected. The agent's timer task may have stopped or the system could be under very high load.",
  "@errMonitorAgentStaleCause": {
    "description": "Cause text for ERR-MON-04 on the troubleshooting card."
  },
  "errMonitorAgentStaleFix": "Wait a minute and refresh. If the status remains stale, check the FAV monitor service and timer on the server. The VPN itself can remain usable while monitoring is unavailable.",
  "@errMonitorAgentStaleFix": {
    "description": "Fix text for ERR-MON-04 on the troubleshooting card."
  },
  "errPeerLabelInvalid": "Use letters, numbers, spaces and ._- only, 1 to 32 characters.",
  "@errPeerLabelInvalid": {
    "description": "User message for error ERR-PEER-01 — invalid peer label."
  },
  "errPeerLabelInvalidCause": "The label you chose for this peer contains characters that are not allowed, or it is outside the permitted length of 1 to 32 characters.",
  "@errPeerLabelInvalidCause": {
    "description": "Cause text for ERR-PEER-01 on the troubleshooting card."
  },
  "errPeerLabelInvalidFix": "Enter a label using only letters, numbers, spaces, dots, underscores and hyphens, keeping it between 1 and 32 characters long.",
  "@errPeerLabelInvalidFix": {
    "description": "Fix text for ERR-PEER-01 on the troubleshooting card."
  },
  "errPeerSubnetExhausted": "No free address left in the VPN subnet. Revoke an unused peer to free up an address.",
  "@errPeerSubnetExhausted": {
    "description": "User message for error ERR-PEER-02 — VPN /24 is full."
  },
  "errPeerSubnetExhaustedCause": "The VPN subnet used by this server has run out of available IP addresses. Every address in the range is already assigned to an existing peer.",
  "@errPeerSubnetExhaustedCause": {
    "description": "Cause text for ERR-PEER-02 on the troubleshooting card."
  },
  "errPeerSubnetExhaustedFix": "Go to the peers list and revoke a peer that is no longer needed. This frees its address and allows you to add a new one.",
  "@errPeerSubnetExhaustedFix": {
    "description": "Fix text for ERR-PEER-02 on the troubleshooting card."
  },
  "errPeerApplyFailed": "The server accepted the configuration but the peer didn't come up. The change was rolled back. Try again, or check the server's WireGuard service.",
  "@errPeerApplyFailed": {
    "description": "User message for error ERR-PEER-03 — wg set did not take effect."
  },
  "errPeerApplyFailedCause": "The configuration for the new peer was written successfully, but when the server applied it to the running WireGuard interface the peer did not appear as expected. The server automatically rolled back the change to keep the VPN consistent.",
  "@errPeerApplyFailedCause": {
    "description": "Cause text for ERR-PEER-03 on the troubleshooting card."
  },
  "errPeerApplyFailedFix": "Try adding the peer again — the rollback means the server is in a clean state. If the error repeats, the WireGuard service on the server may need attention; check the server's system logs for more detail.",
  "@errPeerApplyFailedFix": {
    "description": "Fix text for ERR-PEER-03 on the troubleshooting card."
  },
  "errPeerNotFound": "The peer was not found on the server. The local profile was removed anyway.",
  "@errPeerNotFound": {
    "description": "User message for error ERR-PEER-04 — peer absent at revoke time."
  },
  "errPeerNotFoundCause": "When the app tried to revoke this peer, the peer was already absent from the server's WireGuard configuration. This can happen if the peer was removed directly on the server, or if a previous revoke attempt partially succeeded.",
  "@errPeerNotFoundCause": {
